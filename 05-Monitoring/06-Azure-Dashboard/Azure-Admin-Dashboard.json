            "metadata": {
              "inputs": [
                {
                  "name": "partTitle",
                  "value": "New query 1",
                  "isOptional": true
                },
                {
                  "name": "query",
                  "value": "resources\n| where type in~ ('microsoft.insights/metricalerts','microsoft.insights/scheduledqueryrules') and ['kind'] !in~ ('LogToMetric','LogToApplicationInsights')\n| extend severity = strcat(\"Sev\", properties[\"severity\"])\n| extend enabled = tobool(properties[\"enabled\"])\n| where enabled in~ ('true')\n| project id,name,type,properties,enabled,severity,subscriptionId,['kind']\n| union (resources | where type =~ 'microsoft.alertsmanagement/smartdetectoralertrules' | extend severity = tostring(properties[\"severity\"])\n| extend enabled = properties[\"state\"] =~ 'Enabled' | where enabled in~ ('true') | project id,name,type,properties,enabled,severity,subscriptionId), (resources | where type =~ 'microsoft.insights/activitylogalerts' | extend severity = \"Sev4\"\n| extend enabled = tobool(properties[\"enabled\"]) | mvexpand innerCondition = properties[\"condition\"][\"allOf\"] | where innerCondition[\"field\"] =~ 'category'\n| where enabled in~ ('true') | project id,name,type,properties,enabled,severity,subscriptionId)\n| order by tolower(name) asc",
                  "isOptional": true
                },
                {
                  "name": "chartType",
                  "isOptional": true
                },
                {
                  "name": "isShared",
                  "isOptional": true
                },
                {
                  "name": "queryId",
                  "isOptional": true
                },
